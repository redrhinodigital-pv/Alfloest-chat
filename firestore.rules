rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isParticipant(chatData) {
      return request.auth.uid in chatData.participants;
    }

    function isGroupMember(groupData) {
      return request.auth.uid in groupData.members;
    }

    function isGroupAdmin(groupData) {
      return request.auth.uid in groupData.admins;
    }

    // ── Users Collection ──
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Users can only write their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Chats Collection ──
    match /chats/{chatId} {
      // Only participants can read the chat
      allow read: if isAuthenticated()
        && isParticipant(resource.data);

      // Authenticated users can create chats
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;

      // Only participants can update chat metadata
      allow update: if isAuthenticated()
        && isParticipant(resource.data);

      // Only participants can delete
      allow delete: if isAuthenticated()
        && isParticipant(resource.data);

      // ── Messages Subcollection ──
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated()
          && isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);

        // Participants can create messages
        allow create: if isAuthenticated()
          && isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid;

        // Only the sender can update their message (for reactions, deletions)
        allow update: if isAuthenticated()
          && isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);

        // Sender can delete their own messages
        allow delete: if isAuthenticated()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Groups Collection ──
    match /groups/{groupId} {
      // Members can read group data
      allow read: if isAuthenticated()
        && isGroupMember(resource.data);

      // Authenticated users can create groups
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.members
        && request.auth.uid == request.resource.data.createdBy;

      // Admins can update group, members can update specific fields
      allow update: if isAuthenticated()
        && isGroupMember(resource.data);

      // Only creator can delete the group
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;

      // ── Group Messages Subcollection ──
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);

        allow create: if isAuthenticated()
          && isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data)
          && request.resource.data.senderId == request.auth.uid;

        allow update: if isAuthenticated()
          && isGroupMember(get(/databases/$(database)/documents/groups/$(groupId)).data);

        allow delete: if isAuthenticated()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Notifications Collection ──
    match /notifications/{userId} {
      allow read: if isOwner(userId);
      allow write: if isAuthenticated();

      match /items/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAuthenticated();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
